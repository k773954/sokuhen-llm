# Force Windows line endings for files that are consumed by cmd.exe /
# PowerShell — LF-only .bat files silently mis-parse and exit before
# running anything, which is exactly the "すぐに消える" symptom this
# repo hit.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Python and everything else can keep native line endings on checkout;
# git's autocrlf still normalizes to LF in the repo.
*.py   text
*.md   text
*.toml text
*.json text

# Demo/media assets.
*.png binary
*.gif binary
